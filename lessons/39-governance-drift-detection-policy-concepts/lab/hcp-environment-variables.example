# Configure these as HCP Terraform *environment* variables on the workspace.
# These identifiers are not secrets. The OIDC credential itself is short-lived
# and injected only during the remote run.
TFC_AZURE_PROVIDER_AUTH=true
TFC_AZURE_RUN_CLIENT_ID=11111111-1111-1111-1111-111111111111
ARM_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
ARM_TENANT_ID=22222222-2222-2222-2222-222222222222
