# Optional Azure extension for an HCP Terraform remote run. HCP Terraform
# injects a short-lived OIDC credential when the workspace environment contains
# the values listed in hcp-environment-variables.example. Do not configure a
# client ID, client secret, use_oidc, or oidc_token in this provider block.
terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.80"
    }
  }
}

provider "azurerm" {
  features {}

  use_cli                        = false
  resource_provider_registrations = "none"
}

resource "azurerm_resource_group" "hcp_dynamic_credentials" {
  name     = "${local.normalized_prefix}-${local.environment}-${local.workload_name}-39-rg"
  location = var.location
  tags     = local.common_tags
}
