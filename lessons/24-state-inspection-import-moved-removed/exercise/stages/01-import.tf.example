terraform {
  required_version = ">= 1.12.0, < 2.0.0"

  required_providers {
    random = {
      source  = "hashicorp/random"
      version = "~> 3.9"
    }
  }
}

resource "random_id" "legacy" {
  byte_length = 4
}

import {
  to = random_id.legacy
  id = "p-9hUg"
}

output "identifier" {
  value = random_id.legacy.b64_url
}
